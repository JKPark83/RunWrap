<?xml version="1.0" encoding="utf-8"?>
<!-- Health Connect 읽기 권한 선언.
     문자열은 connect-client 1.1.0의 HealthPermission 상수에서 추출한 값 그대로다 —
     매니페스트에 없는 권한은 요청 시트에서 조용히 거부되므로
     health/HealthPermissions.kt의 셋과 반드시 1:1로 일치해야 한다.
     참고: StepsCadenceRecord는 READ_STEPS에, 경로(ExerciseRoute)는 매니페스트 권한이
     아니라 세션별 동의(ExerciseRouteRequestContract)에 매핑된다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 외부 통신은 날씨(open-meteo)·대기질(에어코리아) 둘뿐 — 건강 데이터는 싣지 않는다 (기획서 §6) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 홈 날씨 브리핑용 대략 위치 — 좌표는 소수 2자리로 반올림해 보내므로 coarse면 충분 (iOS와 동일) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 러닝 코어 (iOS HealthPermissions.core 대응) -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_POWER" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />

    <!-- 체력 배터리 회복 신호 (iOS HealthPermissions.recovery 대응) -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />

    <!-- 30일 초과 이력 — ACWR 4주·PR 8주 산출 재료 (계획서 §2.3) -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- allowBackup=false: 리포트 캐시 등 건강 파생 데이터를 기기 밖(클라우드 백업)에
         두지 않는다 — iOS의 백업 제외 정책(심사 5.1.3(ii) 대응)과 동일. -->
    <application
        android:name=".RunWrapApp"
        android:label="런미새"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="false">

        <!-- Google Maps 키 — local.properties의 MAPS_API_KEY를 빌드가 주입한다 (커밋 금지, 계획서 §1).
             키가 없으면 빈 값이 들어가고 세션 상세가 지도 카드를 빈 상태로 가드한다. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 14+ 필수: 시스템 설정 '권한 사용 이유' 진입점.
             누락하면 HC 권한 시트 자체가 뜨지 않는다. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
